from enum import Enum
from types import TracebackType
from typing import Optional, overload

from torch import Tensor as TorchTensor
from torch.types import Number, Sequence, Union, List


class Tensor: ...
class Scalar: ...

class DataType(Enum):
    Double = ...
    Float = ...
    Half = ...
    Int = ...
    Int32 = ...
    Bool = ...
    BFloat16 = ...
    ComplexFloat = ...
    ComplexDouble = ...
    Null = ...


class Operators: ...


class Fusion:
    def __init__(self, fusion_id: int) -> None: ...
    def define(self, fusion_id: int) -> None: ...
    def defined(self) -> bool: ...
    def execute(self, inputs: Sequence[Union[Tensor, Scalar]]) -> List[TorchTensor]: ...
    def id(self) -> int: ...
    def print(self) -> None: ...


class FusionCache:
    def get(self, max_fusion: int) -> FusionCache: ...
    def num_fusions(self) -> int: ...
    def print_stats(self) -> None: ...


class FusionDefinition:
    def __init__(self, fusion: Fusion, max_length: int = 256) -> None: ...
    @property
    def ops(self) -> Operators: ...
    def __enter__(self) -> None: ...
    def __exit__(self, exc_type: Optional[type[BaseException]], exc_value: Optional[BaseException], traceback: Optional[TracebackType]) -> None: ...
    def __str__(self) -> str: ...
    def add_output(self, output: Union[Tensor, Scalar]) -> None: ...
    @overload
    def define_tensor(self, ndims: int, dtype: DataType, is_cpu: bool = False) -> Tensor: ...
    @overload
    def define_tensor(self, symbolic_sizes: Sequence[int], contiguous: bool, dtype: DataType, is_cpu: bool = False) -> Tensor: ...
    @overload
    def define_tensor(self, sizes: Sequence[int], strides: Sequence[int], dtype: DataType, is_cpu: bool = False) -> Tensor: ...
    def define_constant(self, val: Number) -> Scalar: ...
    def define_scalar(self, dtype: DataType) -> Scalar: ...
